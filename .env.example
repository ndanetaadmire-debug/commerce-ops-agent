# Runtime
NODE_ENV=development
PORT=8080
LOG_LEVEL=info

# LLM (any OpenAI-compatible endpoint: Groq, Azure OpenAI, OpenAI, vLLM)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile

# Commerce backend: "memory" for local demo, "shopify" for a real store
COMMERCE_ADAPTER=memory
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_WEBHOOK_SECRET=

# Business policy
REFUND_AUTO_APPROVE_LIMIT_ZAR=0
MAX_TOOL_STEPS=4
